{
  "schema_version": 2,
  "engine": "qwen3-tts-mlx",
  "model": "mlx-community/Qwen3-TTS-12Hz-1.7B-Base-8bit",
  "device": "mlx",
  "sample_rate": 24000,
  "watermarked": false,
  "endpoint": "/synthesize",
  "reference_audio": {
    "required": true,
    "formats": [
      "wav",
      "mp3",
      "ogg",
      "flac"
    ],
    "min_duration_s": 2.0,
    "max_duration_s": null,
    "note": "reference_text (the exact transcript) is required: this server runs ICL voice cloning only, conditioning on the reference audio and transcript together. ~3 s is enough for high-quality cloning."
  },
  "languages": [
    "de",
    "en",
    "es",
    "fr",
    "it",
    "ja",
    "ko",
    "pt",
    "ru",
    "zh"
  ],
  "parameters": [
    {
      "name": "text",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Text to synthesize, e.g. 'Hello there'.",
      "min": null,
      "max": null,
      "step": null,
      "enum": null,
      "min_length": 1,
      "max_length": null,
      "item_type": null,
      "min_items": null,
      "max_items": null,
      "item_labels": null,
      "group": "common",
      "advanced": false
    },
    {
      "name": "audio_base64",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Reference voice sample as a base64 string.  Any container soundfile can decode (WAV, MP3, OGG, FLAC, ...).  ~3 s is enough for high-quality cloning.",
      "min": null,
      "max": null,
      "step": null,
      "enum": null,
      "min_length": 1,
      "max_length": 10000000,
      "item_type": null,
      "min_items": null,
      "max_items": null,
      "item_labels": null,
      "group": "common",
      "advanced": false
    },
    {
      "name": "reference_text",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Exact transcript of the reference audio.  Required: this server runs ICL (in-context learning) voice cloning only, which conditions on the reference audio and its transcript together.",
      "min": null,
      "max": null,
      "step": null,
      "enum": null,
      "min_length": 1,
      "max_length": null,
      "item_type": null,
      "min_items": null,
      "max_items": null,
      "item_labels": null,
      "group": "common",
      "advanced": false
    },
    {
      "name": "language",
      "type": "string",
      "required": false,
      "default": "en",
      "description": "Two-letter language code, e.g. 'en', 'zh', or 'auto' for auto-detection (supported: de, en, es, fr, it, ja, ko, pt, ru, zh).  Omitted or empty defaults to 'en'.",
      "min": null,
      "max": null,
      "step": null,
      "enum": [
        "auto",
        "zh",
        "en",
        "fr",
        "de",
        "it",
        "ja",
        "ko",
        "pt",
        "ru",
        "es"
      ],
      "min_length": null,
      "max_length": null,
      "item_type": null,
      "min_items": null,
      "max_items": null,
      "item_labels": null,
      "group": "common",
      "advanced": false
    },
    {
      "name": "seed",
      "type": "integer",
      "required": false,
      "default": null,
      "description": "Random seed for reproducibility (seeds MLX's global RNG via mx.random.seed(), which drives the talker's token sampling). If omitted, a random seed in [1, 1000] is chosen and echoed in the response.",
      "min": 1.0,
      "max": 1000.0,
      "step": null,
      "enum": null,
      "min_length": null,
      "max_length": null,
      "item_type": null,
      "min_items": null,
      "max_items": null,
      "item_labels": null,
      "group": "common",
      "advanced": false
    },
    {
      "name": "chunking_enabled",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Split synthesis text into smaller chunks before generation. Disabled by default.",
      "min": null,
      "max": null,
      "step": null,
      "enum": null,
      "min_length": null,
      "max_length": null,
      "item_type": null,
      "min_items": null,
      "max_items": null,
      "item_labels": null,
      "group": "engine",
      "advanced": false
    },
    {
      "name": "chunk_min_chars",
      "type": "integer",
      "required": false,
      "default": 250,
      "description": "Preferred minimum text chunk size when chunking is enabled.",
      "min": 1.0,
      "max": null,
      "step": null,
      "enum": null,
      "min_length": null,
      "max_length": null,
      "item_type": null,
      "min_items": null,
      "max_items": null,
      "item_labels": null,
      "group": "engine",
      "advanced": false
    },
    {
      "name": "chunk_max_chars",
      "type": "integer",
      "required": false,
      "default": 500,
      "description": "Maximum text chunk size when chunking is enabled.",
      "min": 1.0,
      "max": null,
      "step": null,
      "enum": null,
      "min_length": null,
      "max_length": null,
      "item_type": null,
      "min_items": null,
      "max_items": null,
      "item_labels": null,
      "group": "engine",
      "advanced": false
    },
    {
      "name": "chunk_silence_ms",
      "type": "integer",
      "required": false,
      "default": 0,
      "description": "Silence inserted between generated text chunks, in milliseconds. Default is 0.",
      "min": 0.0,
      "max": null,
      "step": null,
      "enum": null,
      "min_length": null,
      "max_length": null,
      "item_type": null,
      "min_items": null,
      "max_items": null,
      "item_labels": null,
      "group": "engine",
      "advanced": false
    },
    {
      "name": "chunk_crossfade_ms",
      "type": "integer",
      "required": false,
      "default": 0,
      "description": "Linear crossfade applied between generated text chunks, in milliseconds (0-50). Mutually exclusive with chunk_silence_ms. Default is 0 (no crossfade).",
      "min": 0.0,
      "max": 50.0,
      "step": null,
      "enum": null,
      "min_length": null,
      "max_length": null,
      "item_type": null,
      "min_items": null,
      "max_items": null,
      "item_labels": null,
      "group": "engine",
      "advanced": false
    }
  ]
}
